{
  "name": "soundvault",
  "version": "1.0.0",
  "description": "Personal sound library manager for game audio designers",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "electron-rebuild --only=better-sqlite3",
    "test": "node --test tests/lexical-search.test.js tests/vector-search.test.js tests/audio-peaks.test.js tests/semantic-e2e.test.js",
    "test:fast": "node --test tests/lexical-search.test.js tests/vector-search.test.js tests/semantic-e2e.test.js",
    "test:audio": "node --test tests/audio-peaks.test.js",
    "test:semantic": "electron tests/semantic-live.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.8.0",
    "electron": "^41.0.3",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/rebuild": "^4.0.3"
  },
  "optionalDependencies": {
    "hnswlib-node": "^3.0.0"
  }
}
