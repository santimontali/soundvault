{
  "name": "soundvault",
  "version": "2.0.0",
  "description": "Personal sound library manager for game audio designers",
  "main": "src/main.js",
  "author": "SoundVault Contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "electron-rebuild --only=better-sqlite3",
    "test": "node --test tests/lexical-search.test.js tests/translate.test.js tests/decode.test.js tests/wav-io.test.js tests/vector-store.test.js tests/echo-core.test.js tests/main-modules.test.js tests/edit-dsp.test.js tests/packaging.test.js tests/style.test.js",
    "test:engine": "node scripts/run-electron-node.js tests/engine.electron.js --hnsw && node scripts/run-electron-node.js tests/clap-fbank.electron.js",
    "test:e2e": "node tests/e2e/run.js --all",
    "icon": "electron scripts/make-icon.js",
    "models": "node scripts/prepare-models.js",
    "prepack": "node scripts/stage-crt-dlls.js && node scripts/prepare-models.js && node scripts/prepare-image-model.js --if-needed && electron scripts/make-icon.js",
    "pack": "electron-builder --dir",
    "predist": "node scripts/stage-crt-dlls.js && node scripts/prepare-models.js && node scripts/prepare-image-model.js --if-needed && electron scripts/make-icon.js",
    "dist": "electron-builder --win",
    "verify:dist": "node scripts/verify-dist.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.8.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^41.0.3",
    "electron-builder": "^26.15.3"
  },
  "optionalDependencies": {
    "hnswlib-node": "^3.0.0"
  },
  "build": {
    "appId": "com.soundvault.app",
    "productName": "soundvault",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "en-US",
      "es",
      "es-419"
    ],
    "files": [
      "**/*",
      "!{tests,docs,scripts,reaper-scripts,packaging,.claude,dist,build,build-assets,web}/**",
      "!*.md",
      "!**/*.{ts,map,gyp,gypi,cc,cpp,c,h,hpp,vcxproj,filters}",
      "!**/{README,Readme,readme,CHANGELOG,Changelog,changelog,HISTORY,History,CONTRIBUTING}{,.md,.markdown,.txt}",
      "!**/.github/**",
      "!node_modules/electron/**",
      "!node_modules/@xenova/transformers/{.cache,dist,types}/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/{darwin,linux}/**",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/sharp/**",
      "!node_modules/{onnx-proto,protobufjs,@protobufjs,long,flatbuffers,guid-typescript,platform,@types,undici-types}/**",
      "!node_modules/{prebuild-install,node-abi,node-addon-api,napi-build-utils,detect-libc,rc,ini,deep-extend,strip-json-comments,minimist,expand-template,github-from-package,mkdirp-classic,chownr,tunnel-agent,safe-buffer,simple-get,simple-concat,decompress-response,mimic-response,pump,end-of-stream,once,wrappy,tar-fs,tar-stream,bl,buffer,base64-js,ieee754,fs-constants,readable-stream,string_decoder,inherits,util-deprecate,b4a,fast-fifo,streamx,text-decoder,teex,events-universal}/**",
      "!node_modules/bare-*/**",
      "!node_modules/{color,color-convert,color-name,color-string,simple-swizzle,is-arrayish,semver}/**",
      "!node_modules/{@derhuerst,env-paths,https-proxy-agent,agent-base,debug,ms,progress,caseless,concat-stream,buffer-from,typedarray,http-response-object,parse-cache-control}/**",
      "!node_modules/hnswlib-node/{src,node_modules}/**",
      "!node_modules/hnswlib-node/build/Release/{obj,addon}/**",
      "!node_modules/hnswlib-node/build/*.{vcxproj,filters,sln}",
      "!node_modules/hnswlib-node/build/Release/*.{pdb,iobj,ipdb,exp,lib}",
      "!node_modules/better-sqlite3/{deps,src}/**",
      "!node_modules/better-sqlite3/build/Release/{obj,test_extension.node}",
      "!node_modules/better-sqlite3/build/Release/obj/**",
      "!node_modules/ffmpeg-static/{install.js,example.js}",
      "!node_modules/fluent-ffmpeg/**",
      {
        "from": "packaging/stubs/onnxruntime-web",
        "to": "node_modules/onnxruntime-web"
      },
      {
        "from": "packaging/stubs/sharp",
        "to": "node_modules/sharp"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node",
      "node_modules/onnxruntime-node/**",
      "node_modules/hnswlib-node/build/Release/addon.node"
    ],
    "extraResources": [
      {
        "from": "build-assets/models/",
        "to": "models/",
        "filter": [
          "Xenova/**",
          "siglip2/{vision_model.onnx,concepts.json,concepts.f16,preprocessor_config.json}"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoundVault",
      "uninstallDisplayName": "SoundVault ${version}",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    }
  }
}
